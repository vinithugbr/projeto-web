<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maison Atelier - Alfaiataria</title>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #f7f5f2;
      color: #333;
    }

    header {
      background: #1c1c1c;
      color: #f5f0e9;
      padding: 20px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    }

    header h1 {
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: 2px;
    }

    header h1 span {
      display: block;
      font-size: 0.85rem;
      font-weight: 300;
      letter-spacing: 1px;
      opacity: 0.75;
      margin-top: 2px;
    }

    .cart-info {
      background: #c9a87c;
      color: #1c1c1c;
      padding: 9px 18px;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cart-info span {
      background: #1c1c1c;
      color: #f5f0e9;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
    }

    .search-box {
      padding: 24px 20px 12px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .search-box input {
      width: 100%;
      padding: 14px 20px;
      border: 1px solid #e0d9cf;
      border-radius: 12px;
      font-size: 1rem;
      background: white;
      outline: none;
    }

    .search-box input:focus {
      border-color: #c9a87c;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 22px;
      padding: 20px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .product-card {
      background: white;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
      display: flex;
      flex-direction: column;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .product-image {
      width: 100%;
      height: 280px;
      object-fit: cover;
      background: #eee;
    }

    .product-info {
      padding: 16px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .product-name {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: #1c1c1c;
      line-height: 1.3;
    }

    .product-price {
      font-size: 1.15rem;
      color: #b08958;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .btn-add {
      background: #1c1c1c;
      color: #f5f0e9;
      border: none;
      padding: 12px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: auto;
      transition: background 0.25s;
    }

    .btn-add:hover {
      background: #333;
    }

    .no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 50px 20px;
      color: #999;
      font-size: 1.1rem;
    }

    footer {
      text-align: center;
      padding: 40px 20px;
      color: #aaa;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <div id="app">
    <header>
      <h1>
        MAISON ATELIER
        <span>Alfaiataria Francesa</span>
      </h1>
      <div class="cart-info">
        Itens no carrinho: <span>{{ cartCount }}</span>
      </div>
    </header>

    <div class="search-box">
      <input 
        type="text" 
        v-model="searchQuery" 
        placeholder="Buscar peças de alfaiataria..."
      >
    </div>

    <div class="products-grid">
      <!-- Componente ProductCard -->
      <product-card
        v-for="product in filteredProducts"
        :key="product.id"
        :name="product.name"
        :price="product.price"
        :image="product.image"
        @add-to-cart="addToCart"
      ></product-card>

      <div v-if="filteredProducts.length === 0" class="no-results">
        Nenhuma peça encontrada para "{{ searchQuery }}"
      </div>
    </div>

    <footer>
      Maison Atelier • Demonstração de componentes e reatividade com Vue.js
    </footer>
  </div>

  <script>
    const { createApp } = Vue;

    // Componente ProductCard (obrigatório)
    const ProductCard = {
      props: {
        name: { type: String, required: true },
        price: { type: Number, required: true },
        image: { type: String, required: true }
      },
      emits: ['add-to-cart'],
      template: `
        <div class="product-card">
          <img :src="image" :alt="name" class="product-image">
          <div class="product-info">
            <div class="product-name">{{ name }}</div>
            <div class="product-price">R$ {{ price.toFixed(2) }}</div>
            <button class="btn-add" @click="$emit('add-to-cart')">
              Adicionar ao Carrinho
            </button>
          </div>
        </div>
      `
    };

    createApp({
      components: {
        ProductCard
      },
      data() {
        return {
          cartCount: 0,
          searchQuery: '',
          products: [
            {
              id: 1,
              name: 'Camisa Social Branca Slim',
              price: 189.90,
              image: 'https://images.unsplash.com/photo-1598033129183-c4f50c736f10?w=500&h=600&fit=crop'
            },
            {
              id: 2,
              name: 'Calça Alfaiataria Cinza',
              price: 259.90,
              image: 'https://images.unsplash.com/photo-1473966968600-fa801b869a1a?w=500&h=600&fit=crop'
            },
            {
              id: 3,
              name: 'Blazer Marinho Clássico',
              price: 499.90,
              image: 'https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=500&h=600&fit=crop'
            },
            {
              id: 4,
              name: 'Camisa Linho Bege',
              price: 219.90,
              image: 'https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?w=500&h=600&fit=crop'
            },
            {
              id: 5,
              name: 'Calça Social Preta',
              price: 279.90,
              image: 'https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=500&h=600&fit=crop'
            },
            {
              id: 6,
              name: 'Colete Alfaiataria',
              price: 189.90,
              image: 'https://images.unsplash.com/photo-1617137968427-85924c800a22?w=500&h=600&fit=crop'
            }
          ]
        };
      },
      computed: {
        filteredProducts() {
          const query = this.searchQuery.toLowerCase().trim();
          if (!query) return this.products;
          return this.products.filter(p => 
            p.name.toLowerCase().includes(query)
          );
        }
      },
      methods: {
        addToCart() {
          this.cartCount++;
        }
      }
    }).mount('#app');
  </script>
</body>
</html>
